{
  "version": 1,
  "sources": {
    "lefant": {
      "type": "local-path",
      "root": "lefant"
    },
    "artem-tasknotes": {
      "type": "git-sparse",
      "repo": "ArtemXTech/personal-os-skills",
      "ref": "main",
      "basePath": "skills"
    },
    "kepano-obsidian": {
      "type": "git-sparse",
      "repo": "kepano/obsidian-skills",
      "ref": "main",
      "basePath": "skills"
    },
    "plugin-skill-dir": {
      "type": "plugin-skill-dir"
    }
  },
  "skills": {
    "tasknotes": {
      "source": "lefant",
      "path": "tasknotes",
      "upstream": {
        "source": "artem-tasknotes",
        "path": "tasknotes"
      },
      "vendorPath": "lefant/tasknotes"
    },
    "obsidian-bases": {
      "source": "kepano-obsidian",
      "path": "obsidian-bases",
      "vendorPath": "vendor/kepano/obsidian-bases"
    },
    "obsidian-cli": {
      "source": "kepano-obsidian",
      "path": "obsidian-cli",
      "vendorPath": "vendor/kepano/obsidian-cli"
    },
    "obsidian-markdown": {
      "source": "kepano-obsidian",
      "path": "obsidian-markdown",
      "vendorPath": "vendor/kepano/obsidian-markdown"
    },
    "remarkable-watcher": {
      "source": "plugin-skill-dir",
      "path": "remarkable-watcher",
      "note": "Usually resolved from a local plugin or sibling checkout by the consuming OpenClaw installation."
    }
  }
}
